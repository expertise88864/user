{
  "_comment": "pa11y-ci config — runs axe + HTMLCS against representative URLs. Round 2-G from OPEN_SOURCE_INTEGRATIONS.md.",
  "defaults": {
    "standard": "WCAG2AA",
    "runners": ["axe", "htmlcs"],
    "timeout": 30000,
    "wait": 1500,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]
    },
    "ignore": [
      "WCAG2AA.Principle1.Guideline1_4.1_4_3.G145.Fail",
      "color-contrast",
      "_comment_above": "Color-contrast initial ignore until palette is audited. Remove once we fix the contrast issues axe surfaces."
    ],
    "reporters": [
      "cli",
      ["json", { "fileName": "pa11y-report.json" }]
    ]
  },
  "urls": [
    "http://127.0.0.1:8080/",
    "http://127.0.0.1:8080/blog",
    "http://127.0.0.1:8080/blog/atopic-dermatitis-overview",
    "http://127.0.0.1:8080/blog/acne-myths",
    "http://127.0.0.1:8080/blog/dermatology-faq",
    "http://127.0.0.1:8080/about",
    "http://127.0.0.1:8080/tools",
    "http://127.0.0.1:8080/glossary"
  ]
}
