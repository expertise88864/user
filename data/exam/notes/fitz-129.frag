<tr><td>1</td><td><strong class="ex-n">&lt;25%</strong> BSA</td><td>Focal or diffuse vacuolar interface</td><td>&gt;500 or persistent anorexia, nausea, vomiting</td><td>2 to 2.9</td></tr>
<tr><td>2</td><td><strong class="ex-n">25%–50%</strong> BSA</td><td>Dyskeratotic keratinocytes</td><td>≥1000</td><td>3 to 5.9</td></tr>
