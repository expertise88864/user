<tr><td>Sindbis virus</td><td>Alphavirus</td><td>2–10</td><td>Acute febrile illness <strong class="ex-n">15%–40%</strong>、headache、malaise、arthralgia</td><td>Rash <strong class="ex-n">80%–90%</strong></td><td>Leucopenia；IgM、IgG ELISA</td><td>Endemic in Eurasia、Africa、Oceania；arthralgia/arthritis <strong class="ex-n">90%</strong>（可持續 6–12 mo）</td></tr>
