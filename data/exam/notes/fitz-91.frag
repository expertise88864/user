<tr><td>Efinaconazole 5% solution</td><td>Dermatophyte onychomycosis</td><td>55%, 53%</td><td>18%, 15%</td></tr>
<tr><td>Tavaborole 8% solution</td><td>Dermatophyte onychomycosis</td><td>31%, 36%</td><td>7%, 9%</td></tr>
<tr><td>Itraconazole</td><td>Dermatophyte onychomycosis</td><td>63%, 66%</td><td>22%, 22%</td></tr>
<tr><td>Terbinafine</td><td>Dermatophyte onychomycosis</td><td>60%</td><td><strong class="ex-n">46%, 44%</strong></td></tr>
<tr><td>Nd:YAG laser</td><td>Temporary increase in clear nail</td><td>11%</td><td>—</td></tr>
