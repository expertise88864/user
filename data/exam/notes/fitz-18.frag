<tr><td>Psoriasis</td><td>HLA cw6</td></tr>
<tr><td>Alopecia areata</td><td>HLA DWB1*03；HLA DR4；HLA DQ7</td></tr>
<tr><td>Psoriatic arthropathy</td><td>HLA B27；B7；B13；B16；B38；B39；B17；HLA cw6</td></tr>
<tr><td>Dermatitis herpetiformis</td><td>HLA DQw2</td></tr>
<tr><td>Pemphigus</td><td>HLA DR4、HLA DQ1</td></tr>
<tr><td>Reactive arthritis syndrome</td><td>HLA B27</td></tr>
<tr><td>Behçet disease</td><td>HLA B51</td></tr>
<tr><td>Carbamazepine-induced SJS and TEN（風險增加）</td><td>HLA-B*1502</td></tr>
</tbody>
