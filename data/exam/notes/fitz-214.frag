<tbody>
<tr><td>Sodium chloride 0.9%</td><td>1000 mL</td><td>1000 mL</td><td>1000 mL</td></tr>
<tr><td>Lidocaine 1%</td><td><strong class="ex-n">100 mL</strong></td><td><strong class="ex-n">75 mL</strong></td><td><strong class="ex-n">50 mL</strong></td></tr>
<tr><td>Epinephrine 1:1000</td><td>1 mL</td><td>1 mL</td><td>1 mL</td></tr>
