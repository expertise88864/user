<tr><td>Adjacent epithelium</td><td>Intact</td><td>Intact</td><td>Disintegrating（dilapidated brick wall）</td></tr>
<tr><td>Adnexal involvement</td><td>Yes</td><td>Yes</td><td>No</td></tr>
<tr><td>Corps ronds and grains</td><td>No</td><td>Yes</td><td>Rarely</td></tr>
