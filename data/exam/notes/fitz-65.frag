<tr><td>ToPAS（Toronto PsA Screen）</td><td>Psoriasis 與一般人口</td><td>Skin、joint、nail</td><td>12</td><td>86.8</td><td>93.1</td><td>0–12；≥8</td></tr>
<tr><td>ToPAS2</td><td>Psoriasis 與一般人口</td><td>Skin、joint、nail、spine</td><td>13</td><td>87.2；92</td><td>82.7；77.2</td><td>0–12；≥7 或 ≥8</td></tr>
