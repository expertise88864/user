<tr><td>DDC</td><td>Myeloid</td><td>CD1c（BDCA-1）、CD1a、CD1b、CD11c、CD11b、CD33、CD172、DEC-205、CLEC6A、CLEC7A、CD206（mannose receptor）</td><td>–</td><td>TLR1–8</td><td>Stimulation of naïve T cells</td><td>TNF-α、IL-8、IL-10、IL-12、IL-23</td></tr>
