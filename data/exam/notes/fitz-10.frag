<thead><tr><th scope="col">DC</th><th scope="col">Precursor</th><th scope="col">Markers</th><th scope="col">Fc receptors</th><th scope="col">TLR</th><th scope="col">Main function</th><th scope="col">Cytokines</th></tr></thead>
<tbody>
