<thead><tr><th scope="col">Subtype</th><th scope="col"># patients</th><th scope="col">% patients</th></tr></thead>
<tbody>
<tr><td>Acne</td><td>11,563</td><td><strong class="ex-n">58%</strong></td></tr>
<tr><td>Rosacea</td><td>9779</td><td><strong class="ex-n">49%</strong></td></tr>
<tr><td>Stinging</td><td>2970</td><td><strong class="ex-n">15%</strong></td></tr>
<tr><td>Allergic</td><td>10,990</td><td><strong class="ex-n">55%</strong></td></tr>
<tr><td>Acne and rosacea</td><td>4909</td><td><strong class="ex-n">25%</strong></td></tr>
<tr><td>Acne and stinging</td><td>1678</td><td><strong class="ex-n">8%</strong></td></tr>
<tr><td>Acne and allergic</td><td>5284</td><td><strong class="ex-n">26%</strong></td></tr>
<tr><td>Rosacea and stinging</td><td>1931</td><td><strong class="ex-n">10%</strong></td></tr>
