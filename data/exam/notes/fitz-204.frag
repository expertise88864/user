<tr><td>Primary：Rowe 1989a</td><td>Meta-analysis；10,276；5 yr</td><td>Any</td><td><strong class="ex-n">10.1</strong></td><td><strong class="ex-n">1.0</strong></td><td>Not reported</td></tr>
