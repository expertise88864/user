<tr><td>IRS, Henle layer</td><td>K25、K27、K28</td><td>K71（K6irs1）</td></tr>
<tr><td>IRS, Huxley layer</td><td>K25、K27、K28</td><td>K71、K74</td></tr>
<tr><td>IRS, cuticle</td><td>K25、K26、K27、K28</td><td>K71、K72、K73</td></tr>
<tr><td>Hair, cuticle</td><td>K32、K35</td><td>K82、K85</td></tr>
<tr><td>Hair, mid- and upper cortex</td><td>K31、K33a、K33b、K34、K35、K36、K37、K38</td><td><strong>K81</strong>、K83、K85、<strong>K86</strong></td></tr>
<tr><td>Hair, medulla</td><td>K16、K17、K25、K27、K28、K33、K34、K37</td><td>K5、K6、K75、<strong>K81</strong></td></tr>
</tbody>
