    "collect": {
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/blog/",
        "http://localhost:8080/blog/acne-myths.html",
        "http://localhost:8080/about.html",
        "http://localhost:8080/tools.html"
      ],
