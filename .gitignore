node_modules/
.pnp/
.pnp.js
.next/
.cache/
dist/
build/

# Vercel
.vercel

# Python bytecode (build scripts run locally)
__pycache__/
*.pyc

# Pagefind output (regenerated by _run_pagefind.py on every Vercel build)
pagefind/

# SEO ops (generated, not source)
_dashboard.md
.indexnow-log.json
_readability.md
_readability.json

# Local one-off audit scratchpads (never commit).
# Convention: leading underscore + .txt = local scratch; ignore them all.
# Whitelist real Python helpers via their .py extension (covered above).
_*.txt
