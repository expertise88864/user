.DS_Store
Thumbs.db
desktop.ini
*~
.vscode/
.idea/

# Logs / temp
*.log
*.tmp
npm-debug.log*
yarn-error.log

# Local env / secrets — NEVER commit
.env
.env.*
*.pem
*.key
